/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miku-server",
  "compatibility_date": "2026-03-12",
  "main": "worker/index.ts",
  "assets": {
    // The path to the directory containing the `index.html` file to be served at `/`
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "miku-server.org/*",
      "zone_name": "miku-server.org"
    }
  ],
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "STEAM_PROFILE_CACHE",
      "id": "bbf1a40d334c4f6f920ea56461873a25"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miku-votes",
      "database_id": "c5c88afc-d273-4c7e-bdf6-e4f3ea8c0532",
      "migrations_dir": "./migrations"
    }
  ],
  "triggers": {
    // Cloudflare cron runs in UTC. The playerbase is CST (UTC+8), so hour ranges
    // here are shifted by -8 from the intended local time.
    //
    // "0 19 * * *"   — daily Steam game-status refresh (03:00 CST)
    // "* 4-15 * * *" — roster poll (ListPlayers) every minute, 12:00–23:59 CST.
    //                  One minute is the finest granularity Cloudflare cron allows.
    //                  Keep this string in sync with ROSTER_CRON in worker/index.ts.
    "crons": ["0 19 * * *", "* 4-15 * * *"]
  },
  "queues": {
    "producers": [
      { "queue": "game-status-refresh", "binding": "GAME_STATUS_QUEUE" },
      { "queue": "rcon-broadcast", "binding": "RCON_BROADCAST_QUEUE" }
    ],
    "consumers": [
      {
        "queue": "game-status-refresh",
        "max_batch_size": 20,
        "max_batch_timeout": 30,
        "max_retries": 2
      },
      {
        // Claim announcements pushed to the game server over RCON.
        "queue": "rcon-broadcast",
        "max_batch_size": 5,
        // Far shorter than the game-status queue: an announcement telling someone to
        // go confirm is useless if it lands 30s late, against a 5 minute request TTL.
        "max_batch_timeout": 3,
        // A pending request lives 5 minutes. Re-broadcasting a failed announcement
        // later would advertise a request that may already be confirmed or expired.
        "max_retries": 0,
        // The whole point of routing this through a queue: exactly one consumer runs
        // at a time account-wide, so concurrent claims can never open concurrent RCON
        // connections. Same guarantee a Durable Object would give, without the DO.
        "max_concurrency": 1
      }
    ]
  },
/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
  // "placement": {  "mode": "smart" }
  /**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
  /**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
  // "vars": {  "MY_VARIABLE": "production_value" }
  /**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
